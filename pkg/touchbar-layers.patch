+/// Read the aggregate (all-core) CPU jiffy counters from `/proc/stat`'s first
+/// line: `(total, idle)`, where `idle` includes iowait. Two samples spaced
+/// apart give a delta-based utilization percentage, the same trick the CPU
+/// power poller already uses on the RAPL energy counter.
+pub(crate) fn read_cpu_jiffies() -> Option<(u64, u64)> {
+    let text = fs::read_to_string("/proc/stat").ok()?;
+    let line = text.lines().next()?;
+    let mut fields = line.split_whitespace();
+    if fields.next()? != "cpu" {
+        return None;
+    }
+    let values: Vec<u64> = fields.filter_map(|f| f.parse().ok()).collect();
+    if values.len() < 4 {
+        return None;
+    }
+    let idle = values[3] + values.get(4).copied().unwrap_or(0); // idle + iowait
+    Some((values.iter().sum(), idle))
+}
