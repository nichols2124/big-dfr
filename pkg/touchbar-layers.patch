+/// Whether any mains power supply (charger) reports `online`; None if there is
+/// no Mains supply to ask.
+fn ac_online() -> Option<bool> {
+    let mut found = None;
+    for entry in fs::read_dir("/sys/class/power_supply").ok()?.flatten() {
+        let p = entry.path();
+        if fs::read_to_string(p.join("type")).map(|t| t.trim() == "Mains").unwrap_or(false) {
+            let online = fs::read_to_string(p.join("online")).map(|o| o.trim() == "1").unwrap_or(false);
+            found = Some(found.unwrap_or(false) || online);
+        }
+    }
+    found
+}
