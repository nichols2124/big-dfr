+fn rearrange_request() -> Option<usize> {
+    let meta = std::fs::metadata(REARRANGE_REQUEST).ok()?;
+    if meta.modified().ok()?.elapsed().unwrap_or_default() > REARRANGE_STALE {
+        let _ = std::fs::remove_file(REARRANGE_REQUEST);
+        return None;
+    }
+    std::fs::read_to_string(REARRANGE_REQUEST).ok()?.trim().parse().ok()
