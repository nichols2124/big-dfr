+/// Like `rounded_rect_path`, but each side's corners can be square: with
+/// ButtonSpacing = 0 adjacent buttons join into one group whose ends alone are
+/// rounded (like the macOS Control Strip).
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn rounded_rect_path_sides(
+    c: &Context,
+    left_edge: f64,
+    width: f64,
+    radius: f64,
+    bot: f64,
+    top: f64,
+    round_left: bool,
+    round_right: bool,
+) {
+    let rl = if round_left { radius } else { 0.0 };
+    let rr = if round_right { radius } else { 0.0 };
+    let l = left_edge;
+    let r = left_edge + width.ceil();
+    c.new_sub_path();
+    c.arc(r - rr, bot + rr, rr, (-90.0f64).to_radians(), 0.0);
+    c.arc(r - rr, top - rr, rr, 0.0, (90.0f64).to_radians());
+    c.arc(l + rl, top - rl, rl, (90.0f64).to_radians(), (180.0f64).to_radians());
+    c.arc(l + rl, bot + rl, rl, (180.0f64).to_radians(), (270.0f64).to_radians());
+    c.close_path();
+}
