+fn permute<T>(v: &mut Vec<T>, perm: &[usize]) {
+    if v.len() != perm.len() {
+        return;
+    }
+    let mut old: Vec<Option<T>> = v.drain(..).map(Some).collect();
+    v.extend(perm.iter().filter_map(|&i| old[i].take()));
